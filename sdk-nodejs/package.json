{
  "name": "@graphlite/sdk",
  "version": "0.1.0",
  "description": "High-level, ergonomic Node.js SDK for GraphLite embedded graph database",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "example:basic": "ts-node examples/basic-usage.ts",
    "example:transactions": "ts-node examples/transactions.ts",
    "example:query-builder": "ts-node examples/query-builder.ts"
  },
  "keywords": [
    "graph",
    "database",
    "gql",
    "embedded",
    "graphlite",
    "graph-database",
    "property-graph",
    "sdk",
    "typescript"
  ],
  "author": "DeepGraph Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepgraph/graphlite.git",
    "directory": "sdk-nodejs"
  },
  "bugs": {
    "url": "https://github.com/deepgraph/graphlite/issues"
  },
  "homepage": "https://github.com/deepgraph/graphlite/tree/main/sdk-nodejs",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "graphlite": "file:../bindings/javascript"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.2.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
